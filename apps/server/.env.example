# =============================================================================
# VedaAI Server Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to git — it contains secrets!
# =============================================================================

# Your Gemini API Key (required)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Server port (optional, defaults to 3001)
PORT=3001

# Allowed frontend origins (comma-separated, optional)
# Defaults to http://localhost:5173 for Vite dev server
# For production, set to your actual frontend domain
ALLOWED_ORIGINS=http://localhost:5173
