{
  "name": "vedaai-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@vedaai/web",
    "dev:server": "npm run dev --workspace=@vedaai/server",
    "dev:all": "npm run dev --workspace=@vedaai/web & npm run dev --workspace=@vedaai/server",
    "build": "npm run build --workspaces --if-present",
    "preview": "npm run preview --workspace=@vedaai/web"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vite": "^8.2.2"
  }
}
